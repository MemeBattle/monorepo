###############################################
### COMMON
###############################################

CAS_PARTNER_ID=685706c5ef9a1d005c9ef9b4
CAS_URL=https://cas.mems.fun
CAS_STATIC_URL=https://cas.mems.fun/static

###############################################
### LIGRETTO
###############################################
LIGRETTO_APP_ENV=development
LIGRETTO_APP_VERSION=development
# `localhost`, not `127.0.0.1`: the whole local SSO stack is one host. The
# sign-in starts here, and the `ligretto` client registered by
# apps/cas/scripts/seed-dev.sh sends the browser back to
# `http://localhost:<LIGRETTO_CORE_BACKEND_PORT>/api/auth/callback`, matched
# byte for byte. @memebattle/ligretto-auth's cookies are `__Host-` prefixed
# and so host-only: a sign-in begun on the other host would not send its
# state cookie to that callback
# (apps/cas/docs/adr/0023-dev-only-client-secret.md).
LIGRETTO_CORE_URL=http://localhost:3333/api
LIGRETTO_GAMEPLAY_URL=localhost:3005
# Read by no application: it records the port ligretto-core-backend serves in
# development — Adonis's own `PORT`, which nothing sets here, hence 3333 — so
# that apps/cas/scripts/seed-dev.sh and the docs take the number from one
# place. Changing it moves the seeded callback alone, which then matches no
# callback the backend sends.
LIGRETTO_CORE_BACKEND_PORT=3333
LIGRETTO_GAMEPLAY_SOCKET_PORT=3005
LIGRETTO_GAMEPLAY_CAS_KEY_PATH=../../key.pem

AMPLITUDE_TOKEN=

LIGRETTO_CORE_APP_KEY=BYnNsw-r-ndJTCy15Uqo8JAF4ONCA4X1
LIGRETTO_CORE_CAS_PUBLIC_KEY_PATH=../../key.pem
LIGRETTO_CORE_PG_HOST=localhost
LIGRETTO_CORE_PG_PORT=5433
LIGRETTO_CORE_PG_USER=ligretto-core-user
LIGRETTO_CORE_PG_PASSWORD=ligretto_pg_password
LIGRETTO_CORE_PG_DB_NAME=ligretto-core
LIGRETTO_CORE_APP_NAME=ligretto-core

# The development secret of the `ligretto` OIDC client in CAS, public by
# construction like apps/cas/dev/signing-key.pem: apps/cas/scripts/seed-dev.sh
# registers the client with exactly this value, so a reset development
# database needs no printed secret copied anywhere. The production client is
# registered separately, with a generated secret
# (apps/cas/docs/adr/0023-dev-only-client-secret.md).
LIGRETTO_CLIENT_SECRET=dev-only-ligretto-secret-public-by-construction

###############################################
###############################################
