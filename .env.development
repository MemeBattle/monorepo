###############################################
### COMMON
###############################################

CAS_PARTNER_ID=685706c5ef9a1d005c9ef9b4
CAS_URL=https://cas.mems.fun
# The dev CAS (apps/cas) reads these files too and `CAS_ISSUER` is its own setting, so this is the issuer it
# publishes as well as the one the gameplay backend verifies tokens against. Production sets it per deployment.
CAS_ISSUER=http://localhost:3000
CAS_STATIC_URL=https://cas.mems.fun/static

###############################################
### LIGRETTO
###############################################
LIGRETTO_APP_ENV=development
LIGRETTO_APP_VERSION=development
# `localhost`, not `127.0.0.1`: the whole local SSO stack is one host.
# @memebattle/ligretto-auth's cookies are `__Host-` prefixed and so host-only,
# so a sign-in begun on the other host would not send its state cookie to the
# callback apps/cas/scripts/seed-dev.sh registers
# (apps/cas/docs/adr/0023-dev-only-client-secret.md).
LIGRETTO_CORE_URL=http://localhost:3333/api
LIGRETTO_GAMEPLAY_URL=localhost:3005
# Read by no application: it records the port ligretto-core-backend serves in
# development — Adonis's own `PORT`, which nothing sets here, hence 3333 — so
# apps/cas/scripts/seed-dev.sh and the docs take the number from one place.
# Changing it moves the seeded callback alone, which then matches no callback
# the backend sends.
LIGRETTO_CORE_BACKEND_PORT=3333
LIGRETTO_GAMEPLAY_SOCKET_PORT=3005

AMPLITUDE_TOKEN=

LIGRETTO_CORE_APP_KEY=BYnNsw-r-ndJTCy15Uqo8JAF4ONCA4X1
LIGRETTO_CORE_PG_HOST=localhost
LIGRETTO_CORE_PG_PORT=5433
LIGRETTO_CORE_PG_USER=ligretto-core-user
LIGRETTO_CORE_PG_PASSWORD=ligretto_pg_password
LIGRETTO_CORE_PG_DB_NAME=ligretto-core
LIGRETTO_CORE_APP_NAME=ligretto-core

# The development secret of the `ligretto` OIDC client in CAS, public by
# construction like apps/cas/dev/signing-key.pem: apps/cas/scripts/seed-dev.sh
# registers the client with this value, so a reset development database needs
# no printed secret copied anywhere. The production client is registered
# separately, with a generated secret
# (apps/cas/docs/adr/0023-dev-only-client-secret.md).
LIGRETTO_CLIENT_ID=ligretto
LIGRETTO_CLIENT_SECRET=dev-only-ligretto-secret-public-by-construction

# ligretto-core-backend's end of the sign-in. Both URIs are what
# apps/cas/scripts/seed-dev.sh registers for the `ligretto` client, and CAS
# matches them byte for byte, so a change here means re-registering it. The app
# URL is where the callback sends the browser back: ligretto-frontend's origin
# in the local SSO stack, served with
#
#   pnpm --filter @memebattle/ligretto-frontend start:dev --port 5174 --strictPort
#
# and not LIGRETTO_APP_URL, which .env sets to the production site for the
# Playwright suites.
LIGRETTO_CORE_AUTH_REDIRECT_URI=http://localhost:3333/api/auth/callback
LIGRETTO_CORE_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5174/
LIGRETTO_CORE_AUTH_APP_URL=http://localhost:5174/
LIGRETTO_CORE_AUTH_SESSION_TRANSPORT=cookie

###############################################
###############################################
