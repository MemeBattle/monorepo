FROM node:24.22-trixie-slim AS dependencies
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME/bin:$PATH"
RUN corepack enable

WORKDIR /memebattle

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml /memebattle/
COPY packages/ligretto-auth/package.json /memebattle/packages/ligretto-auth/
COPY apps/ligretto-core-backend/package.json /memebattle/apps/ligretto-core-backend/

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

FROM dependencies AS build

ENV NODE_ENV=production

COPY packages/ligretto-auth/ /memebattle/packages/ligretto-auth/
# ligretto-auth resolves to its build/ on plain Node, so it is built before the app that imports it.
RUN pnpm run --filter @memebattle/ligretto-auth build

COPY apps/ligretto-core-backend/ /memebattle/apps/ligretto-core-backend/
# tsc -p tsconfig.build.json: the Node entries in build/src/entry, the migrations in build/migrations
# (apps/ligretto-core-backend/docs/adrs/node-build-and-import-specifiers.md).
RUN pnpm run ligretto:core-backend:build

RUN pnpm deploy --prod --filter=@memebattle/ligretto-core-backend /prod

FROM node:24.22-trixie-slim AS runtime
ENV NODE_ENV=production

USER node

COPY --chown=node:node --from=build /prod /ligretto-core-backend
WORKDIR /ligretto-core-backend

# The entry is the argument: the server by default, the migrations and the sweep from the same image with
#   docker run <image> build/src/entry/migrate.js
#   docker run <image> build/src/entry/sweep.js
ENTRYPOINT [ "node" ]
CMD [ "build/src/entry/node.js" ]
