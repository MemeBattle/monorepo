{
  // The browser's view, the settings of `apps/ligretto-frontend`: ES2021 and DOM, no ambient types. It fails when the
  // source reaches for anything a browser bundle does not have.
  "compilerOptions": {
    "lib": ["ES2021", "DOM"],
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src", "kubb.config.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
