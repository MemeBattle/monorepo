{
  // The build a plain-Node consumer loads: CommonJS, because `node build/index.js` cannot type-strip `.ts` inside
  // `node_modules`. `nodenext` is what lets the CJS output `require()` ESM-only `jose` (Node 24 supports it).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./build",
    "rootDir": "./src",
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts", "src/test-support"]
}
