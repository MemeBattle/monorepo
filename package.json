{
  "name": "@memebattle/memebattle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:ci": "pnpm run --parallel --no-bail test:ci",
    "blog:test:ci": "pnpm run --filter @memebattle/blog test:ci",
    "ligretto:start": "docker compose up -d --wait ligretto-core-pg && docker compose --env-file .env.development -f apps/cas/docker-compose.yml --profile image up -d --wait cas && pnpm ligretto:core-backend:migrate && pnpm ligretto:apps:start:dev",
    "ligretto:apps:start:dev": "pnpm run --parallel --no-bail --filter '@memebattle/ligretto-*' start:dev",
    "ligretto:front:build": "pnpm run --filter @memebattle/ligretto-frontend build",
    "ligretto:front:start:dev": "pnpm run --filter @memebattle/ligretto-frontend start:dev",
    "cas:front:build": "pnpm run --filter @memebattle/cas-frontend build",
    "cas:front:start:dev": "pnpm run --filter @memebattle/cas-frontend start:dev",
    "ligretto:gameplay-backend:start:dev": "pnpm run --filter @memebattle/ligretto-gameplay-backend start:dev",
    "ligretto:gameplay-backend:build": "pnpm run --filter @memebattle/ligretto-gameplay-backend build",
    "ligretto:core-backend:build": "pnpm run --filter @memebattle/ligretto-core-backend build",
    "ligretto:core-backend:migrate": "pnpm run --filter @memebattle/ligretto-core-backend migrate",
    "ligretto:core-backend:start:dev": "pnpm run --filter @memebattle/ligretto-core-backend start:dev",
    "ligretto-shared:build": "pnpm run --filter @memebattle/ligretto-shared build",
    "ts-check": "pnpm run --parallel --no-bail ts-check",
    "node:update": "node .scripts/update-node-version.mjs",
    "node:update:check": "node .scripts/update-node-version.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic"
  },
  "devDependencies": {
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@mui/material": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "chromatic": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sass": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "catalog:",
    "wait-on": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.13",
    "pnpm": ">=12.16.1"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
