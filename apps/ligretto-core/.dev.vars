# The development values of the Worker's secrets, read by `cf dev` and the Worker test suite (wrangler's convention).
# Public by construction: the internal token is a development value, and LIGRETTO_CAS_CLIENT_SECRET is the root
# .env.development's, which apps/cas/scripts/seed-dev.sh registers. Production sets its own with
# `cf deploy --secrets-file` (#843).
LIGRETTO_INTERNAL_API_TOKEN=dev-only-internal-api-token-public-by-construction
LIGRETTO_CAS_CLIENT_SECRET=dev-only-ligretto-secret-public-by-construction
