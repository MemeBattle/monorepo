# Development settings of this package, loaded before the repository root .env* files (src/entry/env.ts).
# DATABASE_URL lives here rather than in the root .env.development because apps/cas loads the same root files and
# reads DATABASE_URL for its own database. Override it in .env.development.local (gitignored), see docs/MIGRATIONS.md.
DATABASE_URL=postgres://ligretto-core-user:ligretto_pg_password@localhost:5433/ligretto-core
