{
  "compilerOptions": {
    // No DOM: `Request`, `Response`, `fetch` and `crypto` come from @types/node, and `document` stays a type error.
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "vitest.config.ts", "vitest.worker.config.ts", "cloudflare.config.ts"],
  // The Worker entry is checked by tsconfig.worker.json: @cloudflare/workers-types and @types/node conflict on
  // globals, so each project loads one of them.
  "exclude": ["src/entry/worker.ts"]
}
