{
  "compilerOptions": {
    // No DOM: `Request`, `Response`, `fetch` and `crypto` come from @types/node, and `document` stays a type error.
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "migrations",
    "test/support",
    "test/store",
    "test/http",
    "vitest.config.ts",
    "vitest.worker.config.ts",
    "vitest.store.config.ts",
    "cloudflare.config.ts"
  ],
  // The Worker entry is checked by tsconfig.worker.json: @cloudflare/workers-types and @types/node conflict on
  // globals, so each project loads one of them. The Worker's declaration of `node:async_hooks` would duplicate the one
  // of @types/node.
  "exclude": ["src/entry/worker.ts", "src/entry/worker-node-compat.d.ts"]
}
