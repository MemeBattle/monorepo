{
  "name": "@memebattle/ligretto-core",
  "version": "0.1.0",
  "private": true,
  "description": "The HTTP service of Ligretto on Hono, for Node.js and Cloudflare Workers",
  "license": "MIT",
  "author": "MemeBattle",
  "type": "module",
  "scripts": {
    "start:dev": "tsx watch src/entry/node.ts",
    "dev:worker": "cf dev",
    "build:worker": "cf build",
    "ts-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test:unit": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test": "pnpm run test:unit && pnpm run test:worker",
    "test:ci": "pnpm run test",
    "lint": "pnpm -w exec oxlint apps/ligretto-core"
  },
  "dependencies": {
    "@codexsoft/dotenv-flow": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "cf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
