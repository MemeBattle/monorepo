{
  "name": "@memebattle/ligretto-core",
  "version": "0.1.0",
  "private": true,
  "description": "The HTTP service of Ligretto on Hono, for Node.js and Cloudflare Workers",
  "license": "MIT",
  "author": "MemeBattle",
  "type": "module",
  "scripts": {
    "start:dev": "tsx watch src/entry/node.ts",
    "dev:worker": "cf dev",
    "build:worker": "cf build",
    "migrate": "tsx src/entry/migrate.ts",
    "sweep": "tsx --conditions=development src/entry/sweep.ts",
    "db:codegen": "tsx src/entry/codegen.ts",
    "openapi:generate": "tsx src/entry/openapi.ts",
    "ts-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test:unit": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:store:setup": "docker compose -f ../../docker-compose.yml up -d --wait ligretto-core-pg-test",
    "test:store:run": "vitest run --config vitest.store.config.ts",
    "test:store": "pnpm run test:store:setup && pnpm run test:store:run",
    "test": "pnpm run test:unit",
    "test:ci": "pnpm run test:unit",
    "lint": "pnpm -w exec oxlint apps/ligretto-core"
  },
  "dependencies": {
    "@codexsoft/dotenv-flow": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@memebattle/ligretto-auth": "workspace:^",
    "hono": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "cf": "catalog:",
    "kysely-codegen": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
