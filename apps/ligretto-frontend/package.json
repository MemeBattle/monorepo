{
  "name": "@memebattle/ligretto-frontend",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "main": "./public/index.js",
  "module": "./public/index.js",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.js",
      "./src/*.jsx",
      "./src/*/index.ts",
      "./src/*/index.tsx",
      "./src/*/index.js",
      "./src/*/index.jsx"
    ]
  },
  "scripts": {
    "start:dev": "vite --host --force",
    "build": "vite build",
    "ts-check": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "e2e:start": "playwright test",
    "unused_code:check": "pnpm -w exec knip --no-config-hints --workspace apps/ligretto-frontend",
    "unused_code:remove": "pnpm unused_code:check --fix --allow-remove-files"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.6",
    "@fsmoothy/core": "^1.3.0",
    "@memebattle/analytics": "workspace:^",
    "@memebattle/auth-front": "workspace:^",
    "@memebattle/cas-services": "workspace:^",
    "@memebattle/ligretto-shared": "workspace:^",
    "@memebattle/ui": "workspace:^",
    "@mui/icons-material": "catalog:",
    "@mui/material": "catalog:",
    "@mui/system": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "@sentry/browser": "catalog:",
    "csstype": "catalog:",
    "history": "catalog:",
    "lodash": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-dropzone": "catalog:",
    "react-hotkeys-hook": "catalog:",
    "react-redux": "catalog:",
    "react-router": "catalog:",
    "redux": "catalog:",
    "redux-first-history": "catalog:",
    "socket.io-client": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@storybook/react": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
