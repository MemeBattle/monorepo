  "query": "UPDATE authorization_codes\n           SET redeemed_at = now()\n           WHERE code_hash = $1\n             AND redeemed_at IS NULL\n             AND expires_at > now()\n             AND session_id IS NOT NULL\n           RETURNING\n               id,\n               client_id AS \"client_id: ClientId\",\n               account_id,\n               session_id AS \"session_id!\",\n               redirect_uri,\n               scopes,\n               code_challenge,\n               nonce",
