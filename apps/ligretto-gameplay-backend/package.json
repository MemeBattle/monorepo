{
  "name": "@memebattle/ligretto-gameplay-backend",
  "version": "1.0.9",
  "private": true,
  "description": "The Ligretto game server: a Cloudflare Worker with one Lobby Durable Object and shared Game Durable Objects",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start:dev": "CLOUDFLARE_INCLUDE_PROCESS_ENV=true node --env-file-if-exists=../../.env.development --env-file-if-exists=../../.env.development.local --env-file-if-exists=.env.development node_modules/wrangler/bin/wrangler.js dev --port 3005",
    "build:worker": "wrangler deploy --dry-run --outdir .cloudflare/output",
    "ts-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/cloudflare/tsconfig.json && tsc --noEmit -p test/worker/tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=json --outputFile=report.json",
    "test:watch": "vitest",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "unused_code:check": "pnpm -w exec knip --no-config-hints --workspace apps/ligretto-gameplay-backend",
    "unused_code:remove": "pnpm unused_code:check --fix --allow-remove-files"
  },
  "dependencies": {
    "@memebattle/ligretto-auth": "workspace:^",
    "@memebattle/ligretto-core-client": "workspace:^",
    "@memebattle/ligretto-shared": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "cf": "catalog:",
    "jose": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
