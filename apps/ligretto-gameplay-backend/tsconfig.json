{
  // The rules, compiled against Node's types: no `WebSocket` pair, no Durable Object and no
  // `cloudflare:*` module exists here, which is the proof that src/core does not know what runs it.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/core", "vitest.config.ts"]
}
