{
  "compilerOptions": {
    "esModuleInterop": true,
    // `@memebattle/ligretto-auth` exports source, so this project type-checks it: es2022 for `Error`'s `cause`. The
    // browser globals stay out — this service runs under plain Node, where `document` must be a type error.
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node", "reflect-metadata"],
    "module": "NodeNext",
    "sourceMap": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "build",
    "strict": true,
    // Not compatible with inversify
    "strictPropertyInitialization": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "test/**/*", "vitest.transport.config.ts"]
}
