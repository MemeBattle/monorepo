# The development values of the Worker's secrets, read by `cf dev` and the Worker test suite (wrangler's convention).
# Public by construction: the internal token is a development value, LIGRETTO_CAS_CLIENT_SECRET is the root
# .env.development's, which apps/cas/scripts/seed-dev.sh registers, and DATABASE_URL is the development database, which
# the Worker declares and never reads. Production secrets are set on the Worker, see README.md § First activation.
LIGRETTO_INTERNAL_API_TOKEN=dev-only-internal-api-token-public-by-construction
LIGRETTO_CAS_CLIENT_SECRET=dev-only-ligretto-secret-public-by-construction
DATABASE_URL=postgres://ligretto-core-user:ligretto_pg_password@localhost:5433/ligretto-core
