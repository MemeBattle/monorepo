{
  // `rootDir` is the package, not `src`, so migrate.ts finds build/migrations by the same relative path as in the source.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "build",
    "sourceMap": true
  },
  "include": ["src", "migrations"],
  // codegen.ts and openapi.ts import devDependencies, absent from `pnpm deploy --prod`.
  "exclude": ["src/**/*.spec.ts", "src/entry/worker.ts", "src/entry/worker-node-compat.d.ts", "src/entry/codegen.ts", "src/entry/openapi.ts"]
}
