{
  "compilerOptions": {
    // No DOM: `Request`, `Response`, `fetch` and `crypto` come from @types/node, and `document` stays a type error.
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    // The Node build (tsconfig.build.json) rewrites the `.ts` specifiers to `.js`.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "migrations",
    "test/support",
    "test/store",
    "test/http",
    "test/node",
    "scripts",
    "vitest.config.ts",
    "vitest.worker.config.ts",
    "vitest.store.config.ts",
    "vitest.node.config.ts",
    "cloudflare.config.ts"
  ],
  // Checked by tsconfig.worker.json: @cloudflare/workers-types and @types/node conflict on globals.
  "exclude": ["src/entry/worker.ts", "src/entry/worker-node-compat.d.ts"]
}
