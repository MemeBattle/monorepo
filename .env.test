###############################################
### COMMON
###############################################

CAS_URL=https://cas.mems.fun
# The dev CAS (apps/cas) reads these files too and `CAS_ISSUER` is its own setting, so this is the issuer it
# publishes as well as the one the gameplay backend verifies tokens against. Production sets it per deployment.
CAS_ISSUER=http://localhost:3000

###############################################
### LIGRETTO
###############################################

LIGRETTO_APP_ENV=test

# ligretto-frontend's value; apps/ligretto-gameplay-backend/.env* override it with the internal API's base.
LIGRETTO_CORE_URL=http://127.0.0.1:3333/api
LIGRETTO_GAMEPLAY_URL=localhost:3005
LIGRETTO_CORE_BACKEND_PORT=3333
LIGRETTO_GAMEPLAY_SOCKET_PORT=3005

AMPLITUDE_TOKEN=

LIGRETTO_CORE_APP_KEY=BYnNsw-r-ndJTCy15Uqo8JAF4ONCA4X1

# The suites stub the CAS client at the object level, so none of these reaches a
# network: they are here because ligretto-core-backend validates them at boot.
LIGRETTO_CAS_CLIENT_ID=ligretto
LIGRETTO_CAS_CLIENT_SECRET=dev-only-ligretto-secret-public-by-construction
LIGRETTO_CORE_AUTH_REDIRECT_URI=http://127.0.0.1:3333/api/auth/callback
LIGRETTO_CORE_AUTH_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5174/
LIGRETTO_CORE_AUTH_APP_URL=http://127.0.0.1:5174/
LIGRETTO_CORE_AUTH_SESSION_TRANSPORT=cookie
LIGRETTO_CORE_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
# The shared secret of apps/ligretto-core's internal API, public by construction:
# both sides read it, the service and the gameplay backend calling it.
LIGRETTO_INTERNAL_API_TOKEN=dev-only-internal-api-token-public-by-construction

LIGRETTO_CORE_PG_HOST=localhost
# The throwaway ligretto-core-pg-test service, never the development one: the store suite truncates what it
# points at.
LIGRETTO_CORE_PG_PORT=5435
LIGRETTO_CORE_PG_USER=ligretto-core-user
LIGRETTO_CORE_PG_PASSWORD=ligretto_pg_password
LIGRETTO_CORE_PG_DB_NAME=ligretto-core-test
LIGRETTO_CORE_APP_NAME=ligretto-core

###############################################
###############################################
